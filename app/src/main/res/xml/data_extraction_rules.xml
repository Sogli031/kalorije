<?xml version="1.0" encoding="utf-8"?>
<!-- Ništa ne ide u Android auto-backup ni u prenos uređaj-na-uređaj: jedini
     izvor istine za vraćanje podataka je backup aplikacije u Google Drive-u.
     Delimično vraćeni prefs/baze bi se sudarili sa tim backup-om. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
